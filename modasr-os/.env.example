# ===== MODASR HUB =====
APP_ENV=production
APP_NAME="MODASR HUB"
PUBLIC_URL=https://modasrhub.com
API_URL=https://api.modasrhub.com
MINIAPP_URL=https://modasrhub.com/tg

# Security (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_TTL_MINUTES=60
REFRESH_TTL_DAYS=30
ENCRYPTION_KEY=change-me-32-bytes-hex
CORS_ORIGINS=https://modasrhub.com,https://web.telegram.org

# Database / cache
POSTGRES_USER=modasr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=modasr
DATABASE_URL=postgresql+asyncpg://modasr:change-me@postgres:5432/modasr
REDIS_URL=redis://redis:6379/0

# Telegram (never commit real values)
TG_BOT_TOKEN=
TG_BOT_USERNAME=modasrhub_bot
TG_WEBHOOK_SECRET=change-me
TG_ADMIN_CHAT_ID=
TG_ADMIN_GROUP_ID=
TG_SALES_CHANNEL_ID=

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_USER_LIMIT=60

# Payments
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/modasr-events
N8N_SIGNING_SECRET=change-me

# Storage (S3 compatible)
S3_ENDPOINT=
S3_BUCKET=modasr
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Monitoring
SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=change-me

# Internal service auth (bot → API)
INTERNAL_TOKEN=change-me
