  "esModuleInterop": true, "skipLibCheck": true, "incremental": true, "plugins": [{ "name": "next" }],
  "paths": { "@/*": ["./src/*"] } }, "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"], "exclude": ["node_modules"] }
